VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Never put SUPABASE_SERVICE_ROLE_KEY in frontend env files.
# On Dokploy set the same two names in Environment (runtime).

# Import CLI (scripts in /import, not the React app):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Edge function secrets (invite-user, dispatch-notifications, telegram-webhook, process-deadlines):
# SITE_URL=https://app.example.ru
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_SECURE, SMTP_FROM
# TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET
# CRON_SECRET

